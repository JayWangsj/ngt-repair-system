generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

enum Status {
  RECEIVED
  DIAGNOSING
  WAITING_APPROVAL
  REPAIRING
  PARTS_MISSING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  SALE
  OTHER
}

enum RevenueSource {
  REPAIR
  RETAIL
}

enum ProductUsage {
  RETAIL
  REPAIR
  BOTH
}

enum InventoryMovementType {
  INITIAL_STOCK
  STOCK_IN
  RETAIL_SALE
  REPAIR_USE
  SALE_RETURN
  MANUAL_ADJUSTMENT
}

enum WorkOrderProductKind {
  REPAIR_PART
  RETAIL_ADDON
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  passwordHash       String
  role               Role                @default(STAFF)
  enabled            Boolean             @default(true)
  failedAttempts     Int                 @default(0)
  lockedUntil        DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  payments           Payment[]
  statuses           StatusHistory[]
  audits             AuditLog[]
  inventoryMovements InventoryMovement[]
  retailSales        RetailSale[]
}

model Customer {
  id             String          @id @default(cuid())
  name           String
  phone          String
  consentAt      DateTime?       @db.Timestamptz(3)
  consentVersion String?
  codiceFiscale  String?
  partitaIva     String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  devices        Device[]
  phones         CustomerPhone[]
  deletedAt      DateTime?       @db.Timestamptz(3)
}

model CustomerPhone {
  phone      String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([phone, customerId])
  @@index([customerId])
}

model Device {
  id          String      @id @default(cuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  category    String      @default("PHONE")
  brand       String
  series      String      @default("")
  model       String
  imei        String?
  appearance  String      @default("")
  accessories String      @default("")
  orders      WorkOrder[]
  deletedAt   DateTime?   @db.Timestamptz(3)

  @@index([customerId])
}

model WorkOrder {
  id               String             @id @default(cuid())
  number           Int                @unique @default(autoincrement())
  customerName     String             @default("")
  deviceId         String
  device           Device             @relation(fields: [deviceId], references: [id])
  status           Status             @default(RECEIVED)
  orderDiscount    Decimal            @default(0) @db.Decimal(12, 2)
  includeVat       Boolean            @default(false)
  fault            String
  appearance       String             @default("")
  accessories      String             @default("")
  notes            String             @default("")
  dueDate          String?
  confirmedAt      DateTime?          @db.Timestamptz(3)
  confirmationNote String             @default("")
  pickedUpAt       DateTime?          @db.Timestamptz(3)
  pickedUpBy       String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  items            WorkOrderItem[]
  products         WorkOrderProduct[]
  payments         Payment[]
  history          StatusHistory[]

  @@index([status, dueDate])
  @@index([deviceId])
  @@index([createdAt])
}

model PriceRule {
  id        String          @id @default(cuid())
  category  String          @default("PHONE")
  brand     String          @default("")
  series    String          @default("")
  model     String          @default("")
  project   String
  suggested Decimal         @db.Decimal(12, 2)
  cost      Decimal?        @db.Decimal(12, 2)
  minutes   Int             @default(60)
  enabled   Boolean         @default(true)
  notes     String          @default("")
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  items     WorkOrderItem[]

  @@unique([category, brand, series, model, project])
}

model WorkOrderItem {
  id               String     @id @default(cuid())
  orderId          String
  order            WorkOrder  @relation(fields: [orderId], references: [id])
  ruleId           String?
  rule             PriceRule? @relation(fields: [ruleId], references: [id])
  project          String
  suggested        Decimal?   @db.Decimal(12, 2)
  discount         Decimal    @default(0) @db.Decimal(12, 2)
  final            Decimal    @db.Decimal(12, 2)
  matchLevel       String
  adjustmentReason String     @default("")
  minutes          Int        @default(0)

  @@index([orderId])
}

model Payment {
  id          String              @id @default(cuid())
  requestId   String              @unique
  orderId     String?
  order       WorkOrder?          @relation(fields: [orderId], references: [id])
  saleId      String?
  sale        RetailSale?         @relation(fields: [saleId], references: [id])
  amount      Decimal             @db.Decimal(12, 2)
  method      PaymentMethod
  kind        PaymentKind
  receivedAt  DateTime            @default(now()) @db.Timestamptz(3)
  actorId     String
  actor       User                @relation(fields: [actorId], references: [id])
  actorName   String
  allocations PaymentAllocation[]

  @@index([orderId])
  @@index([saleId])
  @@index([receivedAt])
}

model StatusHistory {
  id        String    @id @default(cuid())
  orderId   String
  order     WorkOrder @relation(fields: [orderId], references: [id])
  from      Status?
  to        Status
  actorId   String
  actor     User      @relation(fields: [actorId], references: [id])
  actorName String
  note      String    @default("")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  entityId  String
  action    String
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  actorName String
  context   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityId, createdAt])
}

model FaultOption {
  id       String  @id @default(cuid())
  category String
  name     String
  key      String
  hidden   Boolean @default(false)

  @@unique([category, key])
}

model Product {
  id                String              @id @default(cuid())
  name              String
  category          String
  usage             ProductUsage
  costPrice         Decimal             @db.Decimal(12, 2)
  salePrice         Decimal             @db.Decimal(12, 2)
  stockQuantity     Int                 @default(0)
  minStock          Int                 @default(0)
  favorite          Boolean             @default(false)
  enabled           Boolean             @default(true)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  movements         InventoryMovement[]
  saleItems         RetailSaleItem[]
  workOrderProducts WorkOrderProduct[]

  @@index([name])
  @@index([category, usage, enabled])
  @@index([enabled, favorite])
}

model RetailSale {
  id        String           @id @default(cuid())
  number    Int              @unique @default(autoincrement())
  requestId String           @unique
  subtotal  Decimal          @db.Decimal(12, 2)
  discount  Decimal          @default(0) @db.Decimal(12, 2)
  total     Decimal          @db.Decimal(12, 2)
  itemCount Int
  actorId   String
  actor     User             @relation(fields: [actorId], references: [id])
  actorName String
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  items     RetailSaleItem[]
  payments  Payment[]

  @@index([createdAt])
}

model RetailSaleItem {
  id          String     @id @default(cuid())
  saleId      String
  sale        RetailSale @relation(fields: [saleId], references: [id])
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  productName String
  category    String
  unitPrice   Decimal    @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal    @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model PaymentAllocation {
  id        String        @id @default(cuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id])
  source    RevenueSource
  amount    Decimal       @db.Decimal(12, 2)

  @@unique([paymentId, source])
  @@index([source])
}

model WorkOrderProduct {
  id          String               @id @default(cuid())
  orderId     String
  order       WorkOrder            @relation(fields: [orderId], references: [id])
  productId   String
  product     Product              @relation(fields: [productId], references: [id])
  productName String
  category    String
  kind        WorkOrderProductKind
  unitPrice   Decimal              @db.Decimal(12, 2)
  discount    Decimal              @default(0) @db.Decimal(12, 2)
  quantity    Int
  consumedAt  DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([orderId, productId, kind])
  @@index([orderId])
  @@index([productId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  requestId     String                @unique
  productId     String
  product       Product               @relation(fields: [productId], references: [id])
  quantity      Int
  stockBefore   Int
  stockAfter    Int
  type          InventoryMovementType
  referenceType String?
  referenceId   String?
  note          String                @default("")
  actorId       String
  actor         User                  @relation(fields: [actorId], references: [id])
  actorName     String
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}
